# Supabase project credentials (Project Settings > API in the Supabase dashboard).
# These are safe to expose to the client: access is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: public @username of the Telegram bot (docs/TELEGRAM.md), used only to
# render a clickable https://t.me/<username> link in Admin > Notificaciones.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
